{
  "name": "ccc-monitor",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:staged": "lint-staged",
    "commit": "git-cz",
    "prepare": "husky",
    "clean": "run-s clean:build clean:caches",
    "clean:build": "pnpm --filter @ccc/* clean",
    "clean:caches": " rimraf .turbo/cache **/*/.turbo",
    "clean:deps": "rimraf node_modules **/*/node_modules",
    "clean:all": "run-s clean:build clean:caches clean:deps",
    "build": "turbo build",
    "build:watch": "turbo build:watch",
    "dev": "turbo dev",
    "dev:server": "pnpm --filter @ccc-monitor/backend-monitor start:dev",
    "prettier": "prettier --write \"(packages|apps|demos)/**/*.@(html|js|cjs|mjs|ts|tsx|css|scss|md)\"",
    "spellcheck": "cspell lint --dot --gitignore --color --cache --show-suggestions \"(packages|apps|demos)/**/*.@(html|js|cjs|mjs|ts|tsx|css|scss|md)\"",
    "docker:start": "docker compose -p ccc-monitor -f .devcontainer/docker-compose.yml up -d",
    "docker:stop": "docker compose -p ccc-monitor -f .devcontainer/docker-compose.yml down",
    "docker:deploy:start": "docker compose -p ccc-monitor -f .devcontainer/docker-compose.deploy.yml up -d",
    "docker:deploy:stop": "docker compose -p ccc-monitor -f .devcontainer/docker-compose.deploy.yml down"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,md}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "25.9.1",
    "@eslint/js": "10.0.1",
    "globals": "17.6.0",
    "typescript-eslint": "8.60.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "cspell": "10.0.1",
    "cz-git": "1.13.1",
    "commitizen": "4.3.1",
    "fast-glob": "3.3.3",
    "@commitlint/config-conventional": "21.0.2",
    "@commitlint/cli": "21.0.2",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "turbo": "2.9.16",
    "rimraf": "6.1.3",
    "npm-run-all2": "9.0.1"
  }
}